{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/:path(.*)",
        "has": [{ "type": "host", "value": "dispatch.niviolab.com" }],
        "destination": "/app/dispatch/:path"
      },
      {
        "source": "/:path(.*)",
        "has": [{ "type": "host", "value": "marketer.niviolab.com" }],
        "destination": "/app/marketer/:path"
      },
      {
        "source": "/:path(.*)",
        "has": [{ "type": "host", "value": "bind.niviolab.com" }],
        "destination": "/app/bind/:path"
      },
      {
        "source": "/:path(.*)",
        "has": [{ "type": "host", "value": "shield.niviolab.com" }],
        "destination": "/app/shield/:path"
      },
      {
        "source": "/:path(.*)",
        "has": [{ "type": "host", "value": "vet.niviolab.com" }],
        "destination": "/app/vet/:path"
      },
      {
        "source": "/:path(.*)",
        "has": [{ "type": "host", "value": "board.niviolab.com" }],
        "destination": "/app/board/:path"
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
